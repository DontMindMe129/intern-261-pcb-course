        <mxCell id="b3" value="ESP32-P4 • revision 3.x&#10;&#10;CPU + DMA + SRAM / PSRAM&#10;Xử lý ảnh và suy luận AI&#10;&#10;CSI / DSI • SDMMC / SDIO&#10;I²C • GPIO / UART / SPI / ADC&#10;&#10;Radio Wi-Fi / Bluetooth ở module ngoài" vertex="1" parent="1" style="rounded=0;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=24;fontStyle=1;fontColor=#20354a;fillColor=#e9f2fb;strokeColor=#20354a;strokeWidth=2;">
